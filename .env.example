# Copy this file to .env and fill in real values. See README.md "Quick Start"
# and docs/KINGA-CLAUDE-CODE-READINESS.md for the full local-setup context.
#
# These four are the ones the app fails to boot without. server/_core/env.ts
# also reads a handful of optional vars (VITE_APP_ID, OAUTH_SERVER_URL,
# OWNER_OPEN_ID, SYSTEM_TEST_MODE, DEV_EMAIL_OVERRIDE,
# HEARTBEAT_ALLOWED_TASK_UIDS) that default to safe/empty values and aren't
# required for local development.

# MySQL/TiDB connection string. TiDB Cloud is the recommended provider for
# local/dev too (see README Quick Start); a local MySQL 8 instance also works.
# Read by drizzle.config.ts and server/_core/env.ts.
DATABASE_URL="mysql://user:password@host:4000/kinga?ssl={\"rejectUnauthorized\":true}"

# Signing key for session cookies (server/_core/env.ts cookieSecret). Any long
# random string; generate one with `openssl rand -hex 32`. Rotating this
# invalidates all existing sessions.
JWT_SECRET="replace-with-a-long-random-secret"

# Manus built-in Forge API key — used server-side for LLM calls, file storage,
# and the Google Maps proxy (server/_core/dataApi.ts, server/storage.ts,
# server/_core/map.ts). Obtain from the Manus Secrets panel for this project.
BUILT_IN_FORGE_API_KEY="replace-with-forge-api-key"

# Base URL for the Forge API above. Obtain alongside BUILT_IN_FORGE_API_KEY
# from the Manus Secrets panel.
BUILT_IN_FORGE_API_URL="https://forge.example.com"
