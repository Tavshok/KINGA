  "query": "\nSELECT \n  c.id,\n  c.status,\n  c.claim_reference,\n  c.created_at,\n  c.updated_at,\n  TIMESTAMPDIFF(HOUR, c.updated_at, NOW()) as hours_since_update,\n  CASE WHEN a.id IS NOT NULL THEN 'YES' ELSE 'NO' END as has_assessment,\n  a.fraud_score,\n  a.estimated_cost,\n  a.fraud_risk_level\nFROM claims c\nLEFT JOIN ai_assessments a ON a.claim_id = c.id\nWHERE c.status NOT IN ('completed', 'rejected', 'closed')\nORDER BY c.updated_at ASC\nLIMIT 20;\n",
